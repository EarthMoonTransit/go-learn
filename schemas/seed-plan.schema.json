{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:go-practice-bank:seed-plan:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "source_commit", "taxonomy_version", "reviewed_by", "reviewed_at", "selected_seeds", "gaps"],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"const": "exercism-go"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "taxonomy_version": {"const": 3},
    "reviewed_by": {"type": "string", "minLength": 2},
    "reviewed_at": {"type": "string", "format": "date"},
    "selected_seeds": {
      "type": "array", "minItems": 30, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "target_skills", "intended_task_forms", "pilot_role", "selection_rationale"],
        "properties": {
          "candidate_id": {"$ref": "#/$defs/candidateId"},
          "target_skills": {"$ref": "#/$defs/skillIds"},
          "intended_task_forms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["implementation", "debugging", "write-tests", "repair-tests", "refactoring", "API-design", "code-review", "integration", "fuzzing", "benchmark", "concurrency-debugging"]}},
          "pilot_role": {"enum": ["introduction", "practice", "transfer", "diagnostic"]},
          "selection_rationale": {"type": "string", "minLength": 20}
        }
      }
    },
    "gaps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["skill_ids", "required_origin", "rationale"],
        "properties": {
          "skill_ids": {"$ref": "#/$defs/skillIds"},
          "required_origin": {"enum": ["original-tasks", "permissive-sources", "debugging-tasks", "production-derived-tasks"]},
          "rationale": {"type": "string", "minLength": 20}
        }
      }
    }
  },
  "$defs": {
    "candidateId": {"type": "string", "pattern": "^(concept|practice)/[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "skillId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"},
    "skillIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/skillId"}}
  }
}
