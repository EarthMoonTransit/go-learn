{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:go-practice-bank:task-provenance:v1",
  "title": "Task provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "upstream_authors", "upstream_contributors", "transformation", "attribution_file"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "path", "commit", "license", "usage_mode"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "path": {"type": "string", "minLength": 1, "maxLength": 300},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "minLength": 2, "maxLength": 120},
        "usage_mode": {"enum": ["adapt", "reference-only", "concepts-only", "blocked"]}
      }
    },
    "upstream_authors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "upstream_contributors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "summary", "independently_authored", "excluded"],
      "properties": {
        "type": {"enum": ["original", "adapted", "translated-adaptation", "combined", "metadata-only"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 500},
        "independently_authored": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excluded": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "attribution_file": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
  }
}
