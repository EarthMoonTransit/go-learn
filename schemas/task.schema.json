{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:go-practice-bank:task-schema:v1",
  "title": "Go Practice Bank task manifest",
  "description": "Normative schema for tasks/ready/<task-id>/task.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "task_type",
    "skills",
    "prerequisites",
    "new_concepts",
    "difficulty",
    "estimated_time_minutes",
    "source",
    "transformation_type",
    "validation_commands",
    "quality_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{3}$",
      "minLength": 8,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "task_type": {
      "enum": ["implement", "debug", "predict", "refactor", "test-writing", "performance"]
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"$ref": "#/$defs/skillId"},
        "secondary": {
          "type": "array",
          "items": {"$ref": "#/$defs/skillId"},
          "uniqueItems": true,
          "maxItems": 3
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {"$ref": "#/$defs/skillId"},
      "uniqueItems": true
    },
    "new_concepts": {
      "type": "array",
      "items": {"$ref": "#/$defs/skillId"},
      "uniqueItems": true,
      "maxItems": 3
    },
    "difficulty": {
      "enum": ["introductory", "basic", "intermediate", "advanced"]
    },
    "estimated_time_minutes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "integer", "minimum": 5, "maximum": 120},
        "max": {"type": "integer", "minimum": 10, "maximum": 180}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "path", "commit", "license"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "path": {"type": "string", "minLength": 1, "maxLength": 300},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "minLength": 2, "maxLength": 120}
      }
    },
    "transformation_type": {
      "enum": ["original", "adapted", "translated-adaptation", "combined", "metadata-only"]
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 4, "maxLength": 300}
    },
    "quality_status": {
      "enum": ["draft", "review", "validated", "ready", "quarantined", "retired"]
    }
  },
  "$defs": {
    "skillId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
    }
  }
}
