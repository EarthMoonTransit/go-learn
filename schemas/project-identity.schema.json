  "$id": "urn:go-practice-bank:project-identity:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "repository", "license", "release_manifest_directory"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"const": "go-practice-bank"},
