{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:go-practice-bank:coverage-scopes:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "decision",
    "foundation",
    "specialist"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "taxonomy_version": {
      "const": 4
    },
    "decision": {
      "const": "docs/adr/0031-foundation-scope-and-taxonomy-v4.md"
    },
    "foundation": {
      "type": "array",
      "minItems": 141,
      "maxItems": 141,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*[.][a-z][a-z0-9-]*$"
      }
    },
    "specialist": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*[.][a-z][a-z0-9-]*$"
      }
    }
  }
}
