{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:go-practice-bank:task-provenance:v2",
  "title": "Multi-source task provenance v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project", "creation", "sources", "attribution_file", "release"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"enum": ["original", "adapted", "combined"]},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "repository", "license", "content_digest"],
      "properties": {
        "identity": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "license": {"type": "string", "minLength": 2, "maxLength": 120},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "creation": {
      "type": "object", "additionalProperties": false,
      "required": ["author", "created_at", "summary"],
      "properties": {
        "author": {"type": "string", "minLength": 1, "maxLength": 100},
        "created_at": {"type": "string", "format": "date"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "sources": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["registry_id", "repository", "commit", "license", "usage_mode", "role", "artifacts"],
        "properties": {
          "registry_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "license": {"type": "string", "minLength": 2, "maxLength": 120},
          "usage_mode": {"enum": ["adapt", "reference-only", "concepts-only", "blocked"]},
          "role": {"enum": ["concept-seed", "api-shape", "adapted-code", "adapted-test-structure", "factual-reference", "comparison-only"]},
          "artifacts": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "sha256", "usage"],
              "properties": {
                "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "minLength": 1, "maxLength": 300},
                "sha256": {"$ref": "#/$defs/digest"},
                "usage": {"enum": ["copied", "adapted", "structure-only", "concept-only", "factual-reference", "comparison-only", "excluded"]}
              }
            }
          }
        }
      }
    },
    "attribution_file": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["binding", "manifest"],
      "properties": {
        "binding": {"const": "deferred-to-release-manifest"},
        "manifest": {"type": "string", "pattern": "^provenance/releases/[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{3}\\.yaml$"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "original"}}}, "then": {"properties": {"sources": {"maxItems": 0}}}},
    {"if": {"properties": {"kind": {"const": "adapted"}}}, "then": {"properties": {"sources": {"minItems": 1}}}},
    {"if": {"properties": {"kind": {"const": "combined"}}}, "then": {"properties": {"sources": {"minItems": 2}}}}
  ],
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
