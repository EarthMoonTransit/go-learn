{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:go-practice-bank:exercism-concept-map:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "source_commit", "taxonomy_version", "review", "concepts"],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"const": "exercism-go"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "taxonomy_version": {"const": 3},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_by", "reviewed_at", "decision"],
      "properties": {
        "status": {"const": "reviewed"},
        "reviewed_by": {"type": "string", "minLength": 2},
        "reviewed_at": {"type": "string", "format": "date"},
        "decision": {"type": "string", "minLength": 2}
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["upstream", "status", "skill_ids", "rationale"],
        "properties": {
          "upstream": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "status": {"enum": ["mapped", "ambiguous", "taxonomy-gap", "scope-deferred"]},
          "skill_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"}
          },
          "rationale": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
