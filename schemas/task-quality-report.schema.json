{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:go-practice-bank:task-quality-report:v1",
  "title": "Machine-readable task quality report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "state", "passed", "gates", "mutants"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string"},
    "state": {"enum": ["draft", "in-review", "ready", "rejected", "retired"]},
    "passed": {"type": "boolean"},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "details"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "status": {"enum": ["pass", "fail", "not-applicable"]},
          "details": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "mutants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "total", "detected", "survived"],
      "properties": {
        "required": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "detected": {"type": "integer", "minimum": 0},
        "survived": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
