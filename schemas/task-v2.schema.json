{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:go-practice-bank:task-schema:v2",
  "title": "Go Practice Bank task contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "activity", "submission", "skills", "prerequisites", "new_concepts", "difficulty", "estimated_time_minutes", "verification", "quality_status"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{3}$", "minLength": 8, "maxLength": 80},
    "title": {"type": "string", "minLength": 8, "maxLength": 120},
    "activity": {"enum": ["implementation", "debugging", "refactoring", "api-design", "test-writing", "test-repair", "fuzz-test-writing", "integration", "performance", "code-review-patch"]},
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "editable_paths", "workspace_skeleton"],
      "properties": {
        "kind": {"enum": ["implementation", "tests", "workspace-patch"]},
        "editable_paths": {"type": "array", "items": {"$ref": "#/$defs/goPath"}, "uniqueItems": true},
        "workspace_skeleton": {"type": "array", "items": {"$ref": "#/$defs/goPath"}, "uniqueItems": true}
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"$ref": "#/$defs/skillId"},
        "secondary": {"type": "array", "items": {"$ref": "#/$defs/skillId"}, "uniqueItems": true, "maxItems": 3}
      }
    },
    "prerequisites": {"type": "array", "items": {"$ref": "#/$defs/skillId"}, "uniqueItems": true},
    "new_concepts": {"type": "array", "items": {"$ref": "#/$defs/skillId"}, "uniqueItems": true, "maxItems": 2},
    "difficulty": {"enum": ["introductory", "basic", "intermediate", "advanced"]},
    "estimated_time_minutes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {"min": {"type": "integer", "minimum": 5, "maximum": 120}, "max": {"type": "integer", "minimum": 10, "maximum": 180}}
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "packages", "public_checks", "grader_checks", "reference_checks", "required_mutants", "race_required", "vet", "limits"],
      "properties": {
        "profile": {"enum": ["fixed-tests", "mutation-tests", "workspace-tests", "fuzz-seed-tests", "benchmark-contract"]},
        "packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/packagePath"}, "uniqueItems": true},
        "public_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/packagePath"}, "uniqueItems": true},
        "grader_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/packagePath"}, "uniqueItems": true},
        "reference_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/packagePath"}, "uniqueItems": true},
        "required_mutants": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
        "race_required": {"type": "boolean"},
        "vet": {"type": "boolean"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command_timeout_seconds", "determinism_runs", "fuzz_seconds", "benchmark_runs"],
          "properties": {
            "command_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
            "determinism_runs": {"type": "integer", "minimum": 2, "maximum": 3},
            "fuzz_seconds": {"type": "integer", "minimum": 0, "maximum": 10},
            "benchmark_runs": {"type": "integer", "minimum": 1, "maximum": 10}
          }
        }
      }
    },
    "quality_status": {"enum": ["draft", "review", "validated", "ready", "quarantined", "retired"]}
  },
  "allOf": [
    {"if": {"properties": {"verification": {"properties": {"profile": {"const": "fixed-tests"}}}}}, "then": {"properties": {"submission": {"properties": {"kind": {"const": "implementation"}, "editable_paths": {"maxItems": 0}, "workspace_skeleton": {"maxItems": 0}}}}}},
    {"if": {"properties": {"verification": {"properties": {"profile": {"const": "mutation-tests"}}}}}, "then": {"properties": {"activity": {"enum": ["test-writing", "test-repair"]}, "submission": {"properties": {"kind": {"const": "tests"}, "editable_paths": {"maxItems": 0}, "workspace_skeleton": {"maxItems": 0}}}}}},
    {"if": {"properties": {"verification": {"properties": {"profile": {"const": "workspace-tests"}}}}}, "then": {"properties": {"submission": {"properties": {"kind": {"const": "workspace-patch"}, "editable_paths": {"minItems": 1}, "workspace_skeleton": {"minItems": 1}}}}}},
    {"if": {"properties": {"verification": {"properties": {"profile": {"const": "fuzz-seed-tests"}}}}}, "then": {"properties": {"activity": {"const": "fuzz-test-writing"}, "submission": {"properties": {"kind": {"const": "tests"}, "editable_paths": {"maxItems": 0}, "workspace_skeleton": {"maxItems": 0}}}}}},
    {"if": {"properties": {"verification": {"properties": {"profile": {"const": "benchmark-contract"}}}}}, "then": {"properties": {"activity": {"const": "performance"}}}}
  ],
  "$defs": {
    "skillId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"},
    "goPath": {"type": "string", "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.go$", "maxLength": 240},
    "packagePath": {"type": "string", "pattern": "^\\./(?:\\.\\.\\.|[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*)$", "maxLength": 240}
  }
}
